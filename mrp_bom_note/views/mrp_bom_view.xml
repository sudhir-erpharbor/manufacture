<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="mrp_bom_view_notes_form" model="ir.ui.view">
        <field name="name">mrp.bom.notes.form</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='miscellaneous']" position="after">
                <page string="Notes" name="additional_notes">
                    <group>
                        <field name="notes" placeholder="Enter notes here..." />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
